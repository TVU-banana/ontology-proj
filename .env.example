# Copy to .env only when needed; loading it requires --env-file .env.
APP_HOST=127.0.0.1
APP_PORT=8000
ACTOR_ID=local_operator
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=100
DATA_ROOT=./data
# Explicit offline model directory; blank keeps parser unconfigured.
DOCLING_ARTIFACTS_PATH=
DOCLING_NUM_THREADS=4
# auto routes uncovered text/table regions; off preserves the historical no-OCR path.
DOCLING_OCR_MODE=auto
# Explicit directory containing the three pinned ONNX files; no runtime downloads.
DOCLING_OCR_MODELS_PATH=
# JSON array of 1-based physical pages, e.g. [2,5]; only valid with auto.
DOCLING_OCR_FORCE_PAGES=[]
NEO4J_URI=
NEO4J_DATABASE=neo4j
NEO4J_USER=
NEO4J_PASSWORD=
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_MODEL=
# Ordered fallback model IDs on the same relay; [] disables fallback.
LLM_FALLBACK_MODELS=["glm-5.3-flash"]
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_DIGEST=
EMBEDDING_NUM_CTX=4096
QUALITY_MODE=demo_accept_all

# Optional confirmed manual identity registry, inside DATA_ROOT; both fields required.
IDENTITY_REGISTRY_PATH=
IDENTITY_REGISTRY_SHA256=
