# Credentials and local configuration, at any depth.
.env
.env.*
*.env
*.env.*
!.env.example
.envrc
.netrc
.npmrc
.pypirc
credentials.json
secrets.json
secrets.yaml
secrets.yml
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*

# Python, build output and local editor/agent state.
.venv/
venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/
dist/
build/
# Required vendored PDF viewer runtime; these are source dependencies.
!/src/ontology_proj/interfaces/http/static/vendor/pdfjs/build/
!/src/ontology_proj/interfaces/http/static/vendor/pdfjs/build/*.mjs
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.DS_Store
.idea/
.vscode/
.agents/
.codex/

# Runtime data, models, databases, logs, exports and backups.
data/
models/
.cache/
*.log
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
/output/
/backups/
/input-pdfs/*
!/input-pdfs/README.md

# Historical artifacts remain local. Already tracked files stay in local history;
# scripts/export_publication.py applies a separate publication allowlist.
/docs/audits/
/docs/reviews/
/docs/demo/
/docs/ui-ux/**/*.png
/docs/ui-ux/**/*.jpg
/docs/ui-ux/**/*.jpeg
**/results/**
!**/results/**/

