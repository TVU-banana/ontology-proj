          ]
        },
        "area_is_approximate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "enum": [
              "observed_at",
              "reported_count",
              "area_original_value",
              "area_original_unit",
              "area_value",
              "area_is_approximate"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "validation_status": {
          "const": "passed"
        },
        "acceptance_status": {
          "enum": [
            "accepted",
            "pending_review"
          ]
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "confirmed"
          ]
        },
        "quality_mode": {
          "enum": [
            "demo_accept_all",
            "demo_one_in_ten",
            "real"
          ]
        },
        "quality_score": {
          "type": "null"
        },
        "source_document_id": {
          "$ref": "#/$defs/Identifier"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "observation_id",
        "observation_code",
        "component_id",
        "defect_id",
        "source_kind",
        "observed_at",
        "assertion",
        "scope",
        "reported_count",
        "description",
